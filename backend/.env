# 后端配置模板（复制为 backend/.env 并按需修改）

# ========== 数据库 ==========
# 生产建议 MySQL：mysql+pymysql://user:password@localhost:3306/friend_circle_analyzer
DATABASE_URL=sqlite:///./test.db

# ========== JWT ==========
SECRET_KEY=change-me-to-a-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ========== 豆包 ==========
DOUBAO_API_KEY=0e2e18c3-b709-4a19-868e-abcdd2c8ed02
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-1-6-flash-250828

# ========== 存储 ==========
# local | tos
STORAGE_BACKEND=local
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=
TOS_BUCKET=

# ========== 成本估算与预警（可选）==========
# 1K tokens 单价（元），不填/填0则不启用成本估算
COST_INPUT_PER_1K_TOKENS=0
COST_OUTPUT_PER_1K_TOKENS=0
# 按日/按月预警阈值（元），不填/填0则不启用预警
DAILY_COST_WARN_THRESHOLD=0
MONTHLY_COST_WARN_THRESHOLD=0

